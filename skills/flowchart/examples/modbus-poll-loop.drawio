<mxfile host="gppi">
  <diagram id="poll" name="Modbus TCP poll loop">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="start" value="node เริ่มทำงาน" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="connect" value="เชื่อมต่อ PLC (Modbus TCP)&lt;br&gt;IP/port จาก CLAUDE.md" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="100" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="d_conn" value="เชื่อมต่อสำเร็จ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="280" y="200" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="backoff" value="&lt;b&gt;DISCONNECTED&lt;/b&gt;&lt;br&gt;publish สถานะ ERROR&lt;br&gt;รอ backoff 1→2→4… s (สูงสุด B_max)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="560" y="210" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="read" value="&lt;b&gt;POLL&lt;/b&gt;&lt;br&gt;อ่าน status block&lt;br&gt;(FC03 request เดียว)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="330" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="d_read" value="ได้ข้อมูล&lt;br&gt;ภายใน T_resp?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="280" y="430" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="publish" value="publish สถานะ&lt;br&gt;+ timestamp ของรอบนี้" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="560" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="wait" value="รอรอบถัดไป (period)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="660" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="d_exc" value="PLC ตอบเป็น&lt;br&gt;exception?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="560" y="430" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="excpub" value="log + diagnostic ERROR&lt;br&gt;(address/ค่าผิด)&lt;br&gt;&lt;b&gt;ไม่ตัดสาย&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="440" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="d_fail" value="ล้มเหลวติดกัน&lt;br&gt;≥ N ครั้ง?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="560" y="570" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="lost" value="&lt;b&gt;LINK LOST&lt;/b&gt;&lt;br&gt;ปิด connection&lt;br&gt;publish stale + ERROR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="560" y="710" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="shutdown" value="node ถูกสั่งปิด&lt;br&gt;(ได้ทุกเมื่อ)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="870" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="close" value="ปิด connection&lt;br&gt;(node นี้อ่านอย่างเดียว ไม่เขียนคำสั่ง)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="970" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="end" value="จบ" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="320" y="1070" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="T_resp, period, N, B_max, IP/port: ค่าจาก CLAUDE.md ของโปรเจกต์ (ห้ามเดา)&lt;br&gt;exception = PLC ยังตอบ สายยังดี → ไม่ reconnect (skill modbus)&lt;br&gt;ทุกข้อความมี timestamp ให้ HMI ตรวจข้อมูลเก่าเอง" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="560" y="870" width="360" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="e_start" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="start" target="connect">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_connect" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="connect" target="d_conn">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_conn_yes" value="ใช่ (รีเซ็ต backoff)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="d_conn" target="read">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_conn_no" value="ไม่ใช่" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#b85450;" edge="1" parent="1" source="d_conn" target="backoff">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_backoff" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="backoff" target="connect">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="660" y="130"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="read" target="d_read">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_read_yes" value="ใช่" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="d_read" target="publish">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_read_no" value="ไม่ใช่" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d_read" target="d_exc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_publish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="publish" target="wait">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_wait" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.333;" edge="1" parent="1" source="wait" target="read">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="690"/>
              <mxPoint x="200" y="350"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_exc_yes" value="ใช่" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d_exc" target="excpub">
          <mxGeometry x="-0.6" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="e_exc_no" value="ไม่ใช่ (timeout / socket error)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="d_exc" target="d_fail">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_excpub" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="excpub" target="wait">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="940" y="820"/>
              <mxPoint x="380" y="820"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_fail_no" value="ไม่ใช่ (ลองรอบหน้า)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d_fail" target="wait">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="520" y="615"/>
              <mxPoint x="520" y="690"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_fail_yes" value="ใช่" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;" edge="1" parent="1" source="d_fail" target="lost">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_lost" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=12;exitX=1;exitY=0.5;entryX=1;entryY=0.5;strokeColor=#b85450;" edge="1" parent="1" source="lost" target="backoff">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="800" y="750"/>
              <mxPoint x="800" y="245"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_shutdown" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="shutdown" target="close">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_close" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="close" target="end">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
